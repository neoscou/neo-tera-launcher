# Exclude lock files and build artifacts from language statistics
Cargo.lock linguist-generated=true
**/Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
**/package-lock.json linguist-generated=true
**/target/** linguist-generated=true
**/node_modules/** linguist-vendored=true
**/dist/** linguist-generated=true

# Force proper language detection for all files
*.rs linguist-language=Rust linguist-detectable=true
*.js linguist-language=JavaScript linguist-detectable=true
*.toml linguist-language=TOML linguist-detectable=true
*.html linguist-language=HTML linguist-detectable=true
*.css linguist-language=CSS linguist-detectable=true
*.json linguist-language=JSON linguist-detectable=true

# Explicitly mark Cargo files
Cargo.toml linguist-language=TOML
**/Cargo.toml linguist-language=TOML
