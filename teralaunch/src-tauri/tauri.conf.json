{
  "build": {
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Neolithic TERA Launcher",
    "version": "1.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": true,
        "open": true
      }
    },
    "windows": [
      {
        "title": "Neolithic TERA Launcher",
        "width": 1282,
        "height": 759,
        "minWidth": 1366,
        "minHeight": 960,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "contentProtected": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.neolithictera.launcher",
      "icon": [
        "icons/logo.png",
        "icons/logo.ico"
      ],
      "copyright": "© 2026 Neolithic TERA. All rights reserved.",
      "shortDescription": "Modern launcher for Neolithic TERA Online",
      "longDescription": "Official launcher for Neolithic TERA Online private server. Download, update, and launch the game with ease.",
      "publisher": "Neolithic TERA",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "wix": {
          "language": "en-US",
          "template": null,
          "bannerPath": null,
          "dialogImagePath": null,
          "componentRefs": [],
          "skipWebviewInstall": false,
          "license": null
        },
        "webviewInstallMode": {
          "type": "downloadBootstrapper"
        }
      }
    }
  }
}