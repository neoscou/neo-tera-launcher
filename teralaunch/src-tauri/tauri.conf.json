{
  "build": {
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Neolithic TERA Launcher",
    "version": "1.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": true,
        "open": true
      }
    },
    "windows": [
      {
        "title": "Neolithic TERA Launcher",
        "width": 1282,
        "height": 759,
        "minWidth": 1280,
        "minHeight": 1024,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "contentProtected": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.teralib.dev",
      "icon": [
        "icons/logo.png",
        "icons/logo.ico"
      ],
      "copyright": "Neolithic TERA Launcher",
      "shortDescription": "Neolithic TERA Launcher"
    }
  }
}